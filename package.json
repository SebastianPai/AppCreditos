{
  "name": "capital-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vapid": "node scripts/generate-vapid.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "bootstrap:admin": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "db:reset": "node --env-file-if-exists=.env.local scripts/reset-keep-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "exceljs": "^4.4.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
