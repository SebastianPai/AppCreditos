# ------------------------------------------------------------------
# Capital Control — variables de entorno
# Copie este archivo como .env.local para desarrollo. NUNCA lo suba al repositorio.
# En Heroku, DATABASE_URL la configura automáticamente el complemento Heroku Postgres.
# ------------------------------------------------------------------

# PostgreSQL. Local sin Docker (npm run db:local):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Solo para el servidor local sin Docker (conexión de superusuario): rol propietario sin privilegios.
DATABASE_ROLE=app_owner

# URL pública de la aplicación (HTTPS en producción).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones push (genere con: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@su-dominio.co

# Tarea diaria (recordatorios y cuotas vencidas): cadena aleatoria larga.
CRON_SECRET=

# Pasarela Wompi (opcional)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
